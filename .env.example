# ─────────────────────────────────────────────────────
#  EPLY — Environment Variables
#  Copy this to .env and fill in your values.
# ─────────────────────────────────────────────────────

# ── LLM API Keys (get at least ONE) ───────────────────
# Groq (free tier, fastest): https://console.groq.com
GROQ_API_KEY=

# Gemini (free tier, multimodal): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude (best reasoning, paid): https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Your WhatsApp Number (digits only, no + or spaces) ──
# Example: 27821234567 for +27 82 123 4567
ADMIN_NUMBER=2348119729920

# ── Group trigger aliases ─────────────────────────────
# In groups, EPLY responds when your number is tagged or text includes @eply.
# Comma-separated aliases are supported, e.g. eply,assistant
EPLY_TRIGGER_NAME=eply

# ── Dashboard ─────────────────────────────────────────
DASHBOARD_PASSWORD=change_this_to_something_strong
SESSION_SECRET=change_this_to_a_long_random_secret
DASHBOARD_PORT=3000
TRUST_PROXY=true
COOKIE_SECURE=false

# ── Redis (Optional — used for digest queue retries) ──
# Railway: add a Redis service and it auto-injects this
# REDIS_URL=redis://localhost:6379

# ── Runtime storage ───────────────────────────────────
# Everything that must survive restarts should live here.
# LOCAL / InterServer: DATA_DIR=./data
# Railway volume:      DATA_DIR=/data
DATA_DIR=./data

# Optional explicit overrides. Leave blank unless your host requires them.
# DB_PATH=./data/eply.db
# AUTH_DIR=./data/auth_info_baileys
# LOG_DIR=./data/logs
# SESSION_DIR=./data/sessions

# ── Daily Digest ──────────────────────────────────────
DIGEST_TIME=07:00
DIGEST_TIMEZONE=Africa/Johannesburg

# ── Notifications ─────────────────────────────────────
# Options: self_chat | secondary_number | telegram | dashboard
NOTIFY_METHOD=self_chat
NOTIFY_NUMBER=

# ── LLM Routing ───────────────────────────────────────
# auto = smart routing (recommended)
# groq | gemini | claude = force a specific model
DEFAULT_MODEL=auto

# ── Voice notes ───────────────────────────────────────
# Voice notes use Groq Whisper first, then Gemini as fallback.
# Optional ISO-639-1 language hint, e.g. en, yo, fr
TRANSCRIBE_LANGUAGE=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
GEMINI_TRANSCRIBE_MODEL=gemini-2.0-flash
MAX_VOICE_TRANSCRIPT_CHARS=3000

# ── Auto-reply master switch ──────────────────────────
# Set to true to enable. Use !off command to disable live.
AUTO_REPLY_ENABLED=true

# ── Runtime ───────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
